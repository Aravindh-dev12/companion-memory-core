# Real provider
OPENAI_API_KEY=

# Provider and persistence
CMC_PROVIDER=openai
CMC_DB_PATH=data/companion.sqlite3
CMC_PERSONA_PATH=persona.yaml

# Current default model split: cheap structured passes, stronger conversational generation.
CMC_EXTRACTION_MODEL=gpt-5.6-luna
CMC_RESOLUTION_MODEL=gpt-5.6-luna
CMC_RESPONSE_MODEL=gpt-5.6-terra
CMC_VERIFICATION_MODEL=gpt-5.6-luna
CMC_ORACLE_MODEL=gpt-5.6-sol
CMC_EMBEDDING_MODEL=text-embedding-3-small

# Ablation/config switches
CMC_RETRIEVAL_MODE=hybrid
CMC_CONSISTENCY_CHECK=true
CMC_TEMPORAL_FILTER=true
CMC_TEMPORAL_RESOLUTION=true
CMC_OPEN_LOOP_FOLLOWUPS=true
CMC_AUTO_CONSOLIDATE=false
CMC_RECENT_EVENT_LIMIT=8
CMC_RETRIEVAL_LIMIT=12
